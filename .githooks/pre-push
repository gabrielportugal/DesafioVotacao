#!/bin/bash

current_branch=$(git symbolic-ref --short HEAD)
echo "🔍 Validando push no branch: $current_branch"

# Lista de branches que exigem testes
test_required_branches=("develop" "main" "release/" "hotfix/")

require_tests=false

for branch in "${test_required_branches[@]}"; do
    if [[ "$current_branch" == "$branch"* ]]; then
        require_tests=true
        break
    fi
done

if [ "$require_tests" = true ]; then
    echo "🧪 Executando testes obrigatórios para $current_branch..."
    
    # Tenta executar os testes
    if ! mvn clean test; then
        echo ""
        echo "❌❌❌ PUSH BLOQUEADO ❌❌❌"
        echo "Testes falharam no branch $current_branch."
        echo "Execute 'mvn test' localmente para ver os erros."
        echo ""
        exit 1
    fi
    
    echo "✅ Testes passaram! Prosseguindo com push..."
else
    echo "⚠️  Testes não obrigatórios para $current_branch"
    read -p "Deseja executar testes mesmo assim? (s/N): " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Ss]$ ]]; then
        mvn test
    fi
fi

exit 0
EOF