# Edite o script .githooks/pre-push
#!/bin/bash

echo "🧪 Executando testes obrigatórios..."

# Navega até o diretório do Maven
if [ -f "desafio/pom.xml" ]; then
    cd desafio
    echo "📁 Diretório do projeto: $(pwd)"
elif [ -f "pom.xml" ]; then
    echo "📁 Diretório do projeto: $(pwd)"
else
    echo "❌ ERRO: pom.xml não encontrado!"
    echo "Procurando pom.xml..."
    find . -name "pom.xml" 2>/dev/null || echo "Nenhum pom.xml encontrado"
    exit 1
fi

# Executa os testes
echo "🔧 Executando mvn test..."
mvn clean test

if [ $? -ne 0 ]; then
    echo ""
    echo "❌❌❌ PUSH BLOQUEADO ❌❌❌"
    echo "Testes falharam no branch develop."
    echo ""
    echo "Execute para debug:"
    echo "  cd desafio && mvn test"
    exit 1
fi

echo "✅ Testes passaram! Continuando push..."
exit 0